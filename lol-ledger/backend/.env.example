# 复制成 backend/.env 后修改。生产环境必须换掉 JWT_SECRET。
# JWT_SECRET 生成：openssl rand -hex 32
JWT_SECRET=please-change-this-to-a-random-64-char-secret-value
DB_PATH=data/ledger.db
TOKEN_TTL_HOURS=12
DEBUG=false
CORS_ORIGINS=http://localhost:5173

# AI 截图识别（DeepSeek V4.1 Flash）。Key 只放服务端环境变量，不要提交到 Git。
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=25
